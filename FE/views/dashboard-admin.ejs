<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administrador - Bienestar Animal Bogotá</title>
    <link rel="stylesheet" href="/interfaz.css">
</head>

<body>

    <%
        const fecha = (valor) => new Date(valor).toLocaleDateString('es-CO');
        const pendientes = refugios.filter(r => r.estado_aprobacion === 'Pendiente');
        const aprobados = refugios.filter(r => r.estado_aprobacion === 'Aprobado');
        const otros = refugios.filter(r => ['Rechazado', 'Suspendido'].includes(r.estado_aprobacion));
    %>

    <nav class="menu">
        <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Abrir o cerrar el menú" autocomplete="off">
        <label for="menu-toggle" class="menu-icono"></label>
        <img src="/imagenes/logo.svg" alt="Logo Bienestar Animal" class="logo">
        <ul class="menu-lista">
            <li><a href="/catalogo" class="activo">Ver Catálogo</a></li>
            <li><a href="/logout" style="color: #EF4444;">Cerrar Sesión</a></li>
        </ul>
        <span class="btn-signin" style="background-color: #EF4444; font-size: 13px;">Administrador</span>
    </nav>

    <main class="contenido-catalogo">

        <div class="catalogo-header">
            <h1>Panel de Control Global (Admin)</h1>
            <p>Bienvenido, <strong><%= email %></strong>. Supervisa la actividad general de la plataforma y valida el registro de nuevos refugios aliados: un refugio no puede ingresar hasta que lo apruebes.</p>
        </div>

        <% if (ok) { %><p class="mensaje-exito"><%= ok %></p><% } %>
        <% if (error) { %><p class="mensaje-error"><%= error %></p><% } %>

        <!-- Sección de Estadísticas Globales del Sistema -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px;">
            <div class="tarjeta-mascota" style="padding: 20px; text-align: center;">
                <h3 style="color: #0EA5E9; font-size: 28px; margin-bottom: 5px;"><%= resumen.animales || 0 %></h3>
                <p class="descripcion-animal" style="margin: 0;">Animales Disponibles</p>
            </div>
            <div class="tarjeta-mascota" style="padding: 20px; text-align: center;">
                <h3 style="color: #10B981; font-size: 28px; margin-bottom: 5px;"><%= resumen.refugios || 0 %></h3>
                <p class="descripcion-animal" style="margin: 0;">Refugios Aliados</p>
            </div>
            <div class="tarjeta-mascota" style="padding: 20px; text-align: center;">
                <h3 style="color: #F59E0B; font-size: 28px; margin-bottom: 5px;"><%= resumen.usuarios || 0 %></h3>
                <p class="descripcion-animal" style="margin: 0;">Usuarios Registrados</p>
            </div>
            <div class="tarjeta-mascota" style="padding: 20px; text-align: center;">
                <h3 style="color: #8B5CF6; font-size: 28px; margin-bottom: 5px;"><%= resumen.adopciones || 0 %></h3>
                <p class="descripcion-animal" style="margin: 0;">Adopciones Exitosas</p>
            </div>
        </div>

        <!-- Contenedor Principal en dos columnas -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px;">
            
            <!-- Columna 1: Moderación de Refugios Pendientes -->
            <div class="tarjeta-mascota" style="padding: 25px;">
                <h3>Solicitudes de Refugios Aliados</h3>
                <p class="descripcion-animal">Revisa y aprueba o rechaza las organizaciones que solicitan unirse a la red de adopción en Bogotá.</p>
                
                <div style="margin: 15px 0;">
                    <% if (pendientes.length === 0) { %>
                        <p class="panel-vacio">No hay solicitudes de registro pendientes.</p>
                    <% } %>
                    <% pendientes.forEach(function(r) { %>
                        <div class="panel-caja">
                            <span class="panel-titulo" style="display: block;"><%= r.nombre %></span>
                            <p class="panel-texto"><%= r.email %><%= r.telefono ? ' • Tel. ' + r.telefono : '' %><%= r.direccion ? ' • ' + r.direccion : '' %></p>
                            <p class="panel-texto">Solicitó el registro el <%= fecha(r.createdAt) %></p>
                            <div class="panel-acciones">
                                <form action="/admin/refugios/<%= r._id %>/estado" method="POST">
                                    <input type="hidden" name="estado" value="Aprobado">
                                    <button type="submit" class="btn-mini btn-mini-verde">Aprobar</button>
                                </form>
                                <form action="/admin/refugios/<%= r._id %>/estado" method="POST">
                                    <input type="hidden" name="estado" value="Rechazado">
                                    <button type="submit" class="btn-mini btn-mini-roja">Rechazar</button>
                                </form>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <% if (aprobados.length > 0 || otros.length > 0) { %>
                    <p class="panel-texto" style="margin: 20px 0 8px;">Refugios ya revisados</p>
                    <% aprobados.forEach(function(r) { %>
                        <div class="panel-caja">
                            <div class="panel-fila">
                                <span class="panel-titulo"><%= r.nombre %></span>
                                <span class="insignia insignia-verde">Aprobado</span>
                            </div>
                        </div>
                    <% }); %>
                    <% otros.forEach(function(r) { %>
                        <div class="panel-caja">
                            <div class="panel-fila">
                                <span class="panel-titulo"><%= r.nombre %></span>
                                <span class="insignia insignia-roja"><%= r.estado_aprobacion %></span>
                            </div>
                            <% if (r.estado_aprobacion === 'Rechazado') { %>
                                <div class="panel-acciones">
                                    <form action="/admin/refugios/<%= r._id %>/estado" method="POST">
                                        <input type="hidden" name="estado" value="Aprobado">
                                        <button type="submit" class="btn-mini btn-mini-verde">Aprobar de todas formas</button>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                <% } %>
            </div>

            <!-- Columna 2: Configuración y Seguridad Global -->
            <div class="tarjeta-mascota" style="padding: 25px;">
                <h3>Configuración del Sistema</h3>
                <p class="descripcion-animal" style="margin-bottom: 15px;">Ajusta parámetros generales de la plataforma web y supervisa los registros de actividad.</p>
                
                <div style="background-color: #0F172A; padding: 20px; border-radius: 8px; border: 1px solid #334155; margin-bottom: 20px;">
                    <p style="color: #F8FAFC; font-size: 14px; margin-bottom: 10px; font-weight: 600;">Estado del Sistema:</p>
                    <ul style="color: #94A3B8; font-size: 14px; padding-left: 20px; margin: 0; line-height: 1.6;">
                        <li>API y base de datos: <span style="color: #10B981;">Conectadas</span></li>
                        <li>Motor EJS: <span style="color: #10B981;">Operativo</span></li>
                        <li>Servidor Express: <span style="color: #10B981;">Activo en Puerto 3000</span></li>
                    </ul>
                </div>

                <button class="boton btn-adoptar" style="width: 100%; cursor: pointer; border: none; background-color: #EF4444;">Generar Reporte General de Adopciones</button>
            </div>

        </div>

    </main>

    <footer class="footer">
        <p>Página desarrollada por Harol Giovanny Lara Suarez</p>
    </footer>

</body>

</html>
